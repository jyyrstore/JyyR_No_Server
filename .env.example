# Public Supabase values: safe for browser use when RLS is configured correctly.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only secrets. NEVER expose these as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Optional provider configuration. Keep credentials server-side only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
WEBHOOK_SIGNING_SECRET=

# Operational controls
DEMO_MODE=false
API_RATE_LIMIT_PER_MINUTE=60
# Provider integrations (server-only)
APP_BASE_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER_TYPE=Local
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
VONAGE_NUMBER_TYPE=mobile-lvn
VONAGE_NUMBER_FEATURES=SMS


WEBHOOK_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret-or-base64-encoded-32-byte-value
