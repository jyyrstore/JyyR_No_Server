import { redirect } from 'next/navigation';
import { createServerSupabaseClient } from '@/lib/supabase-server';
import { AppShell } from '@/components/app-shell';
import { createAdminClient } from '@/lib/supabase-admin';
import { OrderActions } from '@/app/dashboard/orders/[id]/order-actions';
import { OrderLive } from '@/app/dashboard/orders/[id]/order-live';

export default async function ActivationPage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = await params;
  const s = await createServerSupabaseClient();
  const { data: { user } } = await s.auth.getUser();
  if (!user) redirect('/auth/login');
  const { data: o } = await createAdminClient().from('orders').select('id,status,otp_code,phone_number,price_cents,currency,expires_at,countries(code,name,flag),services(name,icon)').eq('id', id).eq('user_id', user.id).maybeSingle();
  if (!o) return <AppShell><div className="glass rounded-2xl p-8">Activation not found.</div></AppShell>;
  return <AppShell><p className="text-sm muted">OTP activation</p><h1 className="text-3xl font-black">#{o.id.slice(0,8).toUpperCase()}</h1><div className="glass mt-6 rounded-3xl p-6"><div className="text-sm muted">{o.countries?.flag} {o.countries?.name} · {o.services?.icon} {o.services?.name}</div><div className="mt-2 text-2xl font-black">{o.phone_number ?? 'Reserving number…'}</div><OrderLive orderId={o.id} initialOtp={o.otp_code} initialStatus={o.status}/></div><OrderActions orderId={o.id} status={o.status}/></AppShell>;
}
